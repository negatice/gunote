# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB Atlas ───────────────────────────────────────
# Cara mendapatkan URI:
# 1. Daftar di https://cloud.mongodb.com (gratis)
# 2. Buat cluster baru (pilih M0 Free)
# 3. Klik "Connect" → "Drivers" → salin connection string
# 4. Ganti <username>, <password>, dan <dbname>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/catatanku?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────
# Ganti dengan string random yang panjang dan kuat
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti-ini-dengan-secret-key-yang-kuat-dan-panjang
JWT_EXPIRES_IN=30d

# ── CORS (Production) ───────────────────────────────────
# Isi dengan URL Vercel setelah deploy frontend
# Bisa beberapa URL dipisah koma
ALLOWED_ORIGINS=https://gunote.vercel.app
